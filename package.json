{
  "name": "auth0-authentication-api-debugger-extension",
  "version": "2.2.0",
  "description": "My extension for ..",
  "main": "index.js",
  "scripts": {
    "build": "npm run clean && npm run extension:build",
    "clean": "rimraf dist",
    "extension:build": "a0-ext build:server ./webtask.js ./dist",
    "serve:dev": "node index.js",
    "test": "mocha 'test/**/*.test.js'"
  },
  "keywords": [
    "auth0",
    "extension"
  ],
  "author": "Auth0",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "auth0-extension": {
    "externals": [
      "auth0@2.17.0",
      "auth0-extension-tools@1.5.2",
      "auth0-extension-express-tools@2.1.0",
      "auth0-oauth2-express@1.2.0",
      "express@4.18.2",
      "lodash@4.8.2",
      "jsonwebtoken@7.1.9",
      "body-parser@1.20.2",
      "webtask-tools"
    ],
    "excluded": [
      "express-conditional-middleware"
    ]
  },
  "dependencies": {
    "auth0": "2.17.0",
    "auth0-extension-express-tools": "2.1.0",
    "auth0-extension-tools": "1.5.2",
    "auth0-oauth2-express": "1.2.0",
    "body-parser": "1.20.2",
    "cors": "2.8.1",
    "express": "4.18.2",
    "handlebars": "^4.0.5",
    "jsonwebtoken": "^7.1.9",
    "lodash": "^4.16.4",
    "nconf": "^0.8.4",
    "webtask-tools": "^3.1.0",
    "winston": "^2.2.0"
  },
  "devDependencies": {
    "auth0-extensions-cli": "^1.3.1",
    "mocha": "^12.0.3",
    "nock": "^13.5.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1"
  }
}
